# The LLM belt is OPTIONAL. With no key set, CiteProof still audits: it runs the
# deterministic corpus + matcher path and simply reports no proposition support.
# Never let the demo depend on this being present.
OPENROUTER_API_KEY=

# Optional: route the belt through a specific provider so the demo is stable.
# OpenRouter load-balances across providers by default, and quantisation can differ.
# OPENROUTER_PROVIDER=

# Overrides the default belt model (google/gemini-2.5-flash).
# OPENROUTER_MODEL=
